# Raw upstream SWE-agent trajectories — immutable, redownloadable, often large.
# See external_data/swe_agent/README.md.
external_data/swe_agent/raw/
external_data/swe_agent/pilot_cache/

# SWE-agent pilot run dirs contain source_trace.json (verbatim upstream).
# Re-materialize via scripts/import_swe_agent_trace.py from the cache.
# Pattern uses /* so individual files can be re-included via !; a plain
# trailing-slash pattern (runs/swe_agent_pilot/) cannot be un-ignored.
runs/swe_agent_pilot/*
# Exception: PILOT_ANNOTATION_SUMMARY.md is a derived statistical doc,
# no upstream content; commit it.
!runs/swe_agent_pilot/PILOT_ANNOTATION_SUMMARY.md
# Exception: GO_NO_GO_MEMO.md (M1) is a derived synthesis doc, no upstream content; commit it.
!runs/swe_agent_pilot/GO_NO_GO_MEMO.md

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
build/
dist/

# Editor / OS
.DS_Store
.idea/
.vscode/
