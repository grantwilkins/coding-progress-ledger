# Raw upstream SWE-agent trajectories — immutable, redownloadable, often large.
# See external_data/swe_agent/README.md.
external_data/swe_agent/raw/
external_data/swe_agent/pilot_cache/

# SWE-agent pilot run dirs contain source_trace.json (verbatim upstream).
# Re-materialize via scripts/import_swe_agent_trace.py from the cache.
# Pattern uses /* so individual files can be re-included via !; a plain
# trailing-slash pattern (runs/swe_agent_pilot/) cannot be un-ignored.
runs/swe_agent_pilot/*
# Exception: PILOT_ANNOTATION_SUMMARY.md is a derived statistical doc,
# no upstream content; commit it.
!runs/swe_agent_pilot/PILOT_ANNOTATION_SUMMARY.md
# Exception: GO_NO_GO_MEMO.md (M1) is a derived synthesis doc, no upstream content; commit it.
!runs/swe_agent_pilot/GO_NO_GO_MEMO.md
# Exception: I1/I2 derived docs, no upstream content; commit them.
!runs/swe_agent_pilot/SCHEMA_GAPS.md
!runs/swe_agent_pilot/SCHEMA_DECISION.md
!runs/swe_agent_pilot/CATEGORY_RESOLUTION_REPORT.md
!runs/swe_agent_pilot/EVIDENCE_AUDIT.md
!runs/swe_agent_pilot/EVIDENCE_AUDIT.json
!runs/swe_agent_pilot/SOURCE_EVIDENCE_GAPS.md
!runs/swe_agent_pilot/CRITIC_AUDIT.md
!runs/swe_agent_pilot/NEXT_DIRECTION_MEMO.md
!runs/swe_agent_pilot/PITFALL8_SENSITIVITY.md
# Exception: T4 derived 20-member rollup set (no upstream content;
# reproducible via scripts/build_pilot_ledger_sets.py). Per-pilot
# singleton set.jsonl files live inside the gitignored pilot subdirs
# and are regenerated alongside ledger.jsonl by the same build script.
!runs/swe_agent_pilot/pilot_rollup_set.jsonl
# Exception: L1/L2 derived dashboard + per-pilot progress CSVs (no upstream content).
!runs/swe_agent_pilot/PILOT_DASHBOARD.md
!runs/swe_agent_pilot/plots/
!runs/swe_agent_pilot/plots/*.csv

# H4 v3 cold-pass run dirs mirror source_trace.json (verbatim upstream).
# Re-materialize via scripts/annotate_pilots_from_spec.py against
# annotations/swe_agent_pilot_v3/.
runs/swe_agent_pilot_v3/

# Hermes — same pattern as swe_agent.
external_data/hermes/raw/*
!external_data/hermes/raw/sample_row_kimi.json
!external_data/hermes/raw/sample_row_glm-5.1.json
external_data/hermes/pilot_cache/
runs/hermes_pilot/*
!runs/hermes_pilot/HERMES_PARITY_REPORT.md

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
build/
dist/

# Editor / OS
.DS_Store
.idea/
.vscode/
