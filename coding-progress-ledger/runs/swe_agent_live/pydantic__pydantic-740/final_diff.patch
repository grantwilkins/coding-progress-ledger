+from dataclasses import dataclass, field
+from typing import Any
+
+# comment the pydantic import below to see the expected result
+from pydantic.dataclasses import dataclass
+
+@dataclass
+class Base:
+    x: float
+    y: float
+
+    def __post_init__(self):
+        print('Called!')
+        self.z = self.x + self.y
+        print(f"Set z attribute to {self.z}")
+
+@dataclass
+class Child(Base):
+    a: int
+
+    def __post_init__(self):
+        super().__post_init__()
+    a: int
+
+obj = Child(a=0, x=1.5, y=2.5)
+print(obj.z)
