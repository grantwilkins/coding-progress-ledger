+import asyncio
+from zaza.model import async_set_application_config
+
+# Settings to be tested
+settings = {
+    test-mode: True,
+    transmit-vendor-metrics: False,
+    automatically-retry-hooks: False,
+}
+
+# Model and application names
+model_name = test-model
+application_name = test-application
+
+# Set the configuration using asyncio
+loop = asyncio.get_event_loop()
+task = loop.create_task(async_set_application_config(model_name, application_name, settings))
+loop.run_until_complete(asyncio.wait([task], loop=loop))
+
+print(Configuration set successfully.)
+
