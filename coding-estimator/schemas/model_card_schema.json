{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-estimator/model_card_schema",
  "title": "EstimatorModelCard",
  "description": "Required fields on every model card. Plan § 15.5 lists these as the contract for any consumer of a saved estimator bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estimator_id",
    "estimator_version",
    "model_family",
    "training_data",
    "source_versions",
    "feature_groups",
    "target_definitions",
    "split_protocol",
    "known_limits",
    "not_safe_for_control",
    "calibration_status",
    "intended_use",
    "non_use_cases",
    "commit_sha",
    "failure_mode_results"
  ],
  "properties": {
    "estimator_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_v[0-9]+\\.[0-9]+(?:_[a-z][a-z0-9_]*)?$",
      "description": "Format: <model_family>_v<major>.<minor>[_<source-slice>]. Per docs/VERSIONING.md."
    },
    "estimator_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "model_family": {
      "type": "string",
      "enum": ["logreg", "empirical_bin", "constant", "time_only", "ledger_basic"]
    },
    "training_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoints_path", "labels_path", "n_runs", "n_checkpoints"],
      "properties": {
        "checkpoints_path": {"type": "string"},
        "labels_path": {"type": "string"},
        "n_runs": {"type": "integer", "minimum": 0},
        "n_checkpoints": {"type": "integer", "minimum": 0}
      }
    },
    "source_versions": {
      "type": "object",
      "description": "Map of source_id -> source_protocol_version observed in the training frame.",
      "additionalProperties": {"type": "string"}
    },
    "feature_groups": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["frontier", "closure", "discovery", "instability", "stalling", "validation", "evidence", "time_budget", "source_task"]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "target_definitions": {
      "type": "object",
      "description": "Map of target_name -> {family, horizon_units, horizon_value, run_constant_flag}.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "horizon_units"],
        "properties": {
          "family": {"type": "string"},
          "horizon_units": {"type": "string", "enum": ["steps", "seconds", "terminal", "none"]},
          "horizon_value": {"type": ["integer", "null"]},
          "run_constant_flag": {"type": "boolean"}
        }
      }
    },
    "split_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline_scheme", "diagnostic_schemes"],
      "properties": {
        "headline_scheme": {"type": "string", "enum": ["holdout", "loro", "ltfo", "loso"]},
        "diagnostic_schemes": {
          "type": "array",
          "items": {"type": "string", "enum": ["holdout", "loro", "ltfo", "loso"]},
          "uniqueItems": true
        },
        "headline_seed": {"type": "integer"}
      }
    },
    "known_limits": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Plain-text limitations a consumer must respect."
    },
    "not_safe_for_control": {
      "type": "boolean",
      "description": "True iff this estimator must NOT drive scheduling, modulation, or other control actions. Default true. Flip only if O1, O5, O7 and P1 all pass with margin."
    },
    "calibration_status": {
      "type": "object",
      "description": "Map of target_name -> {brier, ece, ece_3bin, auroc, n_checkpoints, calibration_method}.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["brier", "ece", "n_checkpoints"],
        "properties": {
          "brier": {"type": ["number", "null"]},
          "ece": {"type": ["number", "null"]},
          "ece_3bin": {"type": ["number", "null"]},
          "auroc": {"type": ["number", "null"]},
          "n_checkpoints": {"type": "integer", "minimum": 0},
          "calibration_method": {
            "type": "string",
            "enum": ["raw", "platt", "isotonic", "source_isotonic", "constant"]
          }
        }
      }
    },
    "intended_use": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "non_use_cases": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "failure_mode_results": {
      "type": "object",
      "description": "Outcome of every Workstream O test that ran. Required so a consumer can read 'has this model been adversarially probed?' from the card alone.",
      "additionalProperties": false,
      "required": ["O1", "O5", "O7"],
      "properties": {
        "O1": {"$ref": "#/$defs/failure_mode_record"},
        "O5": {"$ref": "#/$defs/failure_mode_record"},
        "O7": {
          "oneOf": [
            {"$ref": "#/$defs/failure_mode_record"},
            {"type": "array", "items": {"$ref": "#/$defs/failure_mode_record"}}
          ]
        }
      }
    },
    "go_no_go_gate": {
      "type": "object",
      "description": "Optional pointer to the P1 gate report and its overall verdict.",
      "additionalProperties": false,
      "properties": {
        "verdict": {"type": "string", "enum": ["pass", "fail", "indeterminate"]},
        "report_path": {"type": "string"}
      }
    }
  },
  "$defs": {
    "failure_mode_record": {
      "type": "object",
      "additionalProperties": true,
      "required": ["outcome", "metric_name", "threshold"],
      "properties": {
        "test_id": {"type": "string"},
        "outcome": {"type": "string", "enum": ["pass", "fail", "indeterminate"]},
        "metric_name": {"type": "string"},
        "metric_value": {"type": ["number", "null"]},
        "threshold": {"type": "number"},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}
