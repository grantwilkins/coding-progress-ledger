{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-estimator/estimator_output_schema",
  "title": "EstimatorPrediction",
  "description": "One row per (run_id, checkpoint_id, target_name, model_id).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "source",
    "checkpoint_id",
    "model_id",
    "model_version",
    "target_name",
    "target_family",
    "target_horizon",
    "probability",
    "prediction_kind",
    "calibration_bucket",
    "calibration_source",
    "estimator_commit_sha",
    "schema_version"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "target_name": {"type": "string", "pattern": "^y_[a-z0-9_]+$"},
    "target_family": {
      "type": "string",
      "enum": ["success", "progress_dynamics", "validation", "submission"]
    },
    "target_horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "value"],
      "properties": {
        "units": {"type": "string", "enum": ["steps", "seconds", "terminal", "none"]},
        "value": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "prediction_kind": {"type": "string", "enum": ["binary"]},
    "calibration_bucket": {"type": ["integer", "null"], "minimum": 0},
    "calibration_source": {
      "type": "string",
      "enum": ["isotonic", "platt", "raw", "constant"]
    },
    "estimator_commit_sha": {"type": "string", "minLength": 7},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "regression_value": {"type": ["number", "null"]},
    "regression_units": {"type": ["string", "null"]},
    "lower_ci": {"type": ["number", "null"]},
    "upper_ci": {"type": ["number", "null"]},
    "top_feature_attributions": {"type": ["string", "null"]}
  }
}
