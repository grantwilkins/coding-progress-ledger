{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-estimator/label_schema",
  "title": "EstimatorLabel",
  "description": "Long-form label table: one row per (run_id, checkpoint_id, target_name).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "source",
    "checkpoint_id",
    "target_name",
    "target_family",
    "target_horizon",
    "label_value",
    "is_masked",
    "schema_version"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "target_name": {"type": "string", "pattern": "^y_[a-z0-9_]+$"},
    "target_family": {
      "type": "string",
      "enum": ["success", "progress_dynamics", "validation", "submission"]
    },
    "target_horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "value"],
      "properties": {
        "units": {"type": "string", "enum": ["steps", "seconds", "terminal", "none"]},
        "value": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "label_value": {"type": ["integer", "number", "null"]},
    "is_masked": {"type": "boolean"},
    "mask_reason": {"type": ["string", "null"]},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  }
}
