{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-estimator/split_schema",
  "title": "EstimatorSplit",
  "type": "object",
  "additionalProperties": false,
  "required": ["scheme", "seed", "folds", "schema_version"],
  "properties": {
    "scheme": {"type": "string", "enum": ["loro", "ltfo", "loso", "holdout", "temporal"]},
    "seed": {"type": "integer"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "folds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fold_id", "train_run_ids", "test_run_ids"],
        "properties": {
          "fold_id": {"type": "string", "minLength": 1},
          "train_run_ids": {
            "type": "array", "items": {"type": "string"}, "uniqueItems": true
          },
          "test_run_ids": {
            "type": "array", "items": {"type": "string"}, "uniqueItems": true, "minItems": 1
          },
          "val_run_ids": {
            "type": "array", "items": {"type": "string"}, "uniqueItems": true
          }
        }
      }
    }
  }
}
